# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# DATA MODE: "demo" (default) = app fully LOCAL (browser localStorage).
# "live" ya missing = Supabase/cloud sync on hota hai (tab adapter plug karein).
VITE_DATA_MODE="demo"

# Supabase (primary cloud backend — replaces Firebase)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_key_here"
# SECRET (service-role) — sirf server-side scripts ke liye (kabhi client mein nahi)
SUPABASE_SECRET_KEY="REPLACE_WITH_YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"
